{
  "program": "cake.com",
  "display_name": "Cake Security — web+api",
  "enabled": true,
  "authorization_reference": "https://security.cake.com/",
  "allowed_hosts": [
    "app.clockify.me",
    "app.plaky.com",
    "app.pumble.com",
    "account.cake.com",
    "marketplace.cake.com",
    "developer.marketplace.cake.com",
    "api.clockify.me",
    "*.api.clockify.me",
    "api.plaky.com",
    "*.api.plaky.com",
    "api-ga.pumble.com",
    "*.api-ga.pumble.com",
    "api.marketplace.cake.com",
    "*.api.marketplace.cake.com",
    "api.developer.marketplace.cake.com",
    "*.api.developer.marketplace.cake.com"
  ],
  "denied_hosts": [],
  "allowed_methods": [
    "GET",
    "HEAD"
  ],
  "allowed_ports": [
    443
  ],
  "max_requests_per_second": 0.2,
  "require_https": true,
  "allow_redirects": false,
  "probe_timeout_seconds": 10,
  "max_response_bytes": 262144
}
