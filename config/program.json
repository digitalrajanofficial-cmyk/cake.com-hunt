{
  "program": "cake.com",
  "display_name": "Cake Security",
  "enabled": true,
  "authorization_reference": "https://security.cake.com/",
  "allowed_hosts": [
    "security.cake.com",
    "api.cake.com"
  ],
  "denied_hosts": [],
  "allowed_methods": [
    "GET",
    "HEAD"
  ],
  "allowed_ports": [
    443
  ],
  "max_requests_per_second": 0.2,
  "require_https": true,
  "allow_redirects": false,
  "probe_timeout_seconds": 10,
  "max_response_bytes": 262144
}
